{
  "name": "n3xt0r/wp-xpub",
  "description": "Flexible Multi-Channel Auto Publisher for WordPress",
  "type": "wordpress-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Ilya Beliaev",
      "email": "info@php-dev.info",
      "homepage": "https://blog.php-dev.info",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "monolog/monolog": "^3.9",
    "league/html-to-markdown": "^5.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "N3XT0R\\XPub\\": "src/",
      "N3XT0R\\XPub\\Tests": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0.x-dev"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
